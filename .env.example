# Copy to .env.local (or set in Vercel → Settings → Environment Variables).

# Your live domain, no trailing slash. Used for canonical URLs, link previews, sitemap.xml and robots.txt.
# On Vercel this falls back to the production URL automatically, but set it once you have a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Search Console → Add property → "HTML tag" method → paste only the content="..." value.
GOOGLE_SITE_VERIFICATION=
